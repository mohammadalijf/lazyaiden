# Generated by packaging/homebrew/render.sh in the lazyaiden release workflow; do not edit by hand.
class @CLASS@ < Formula
  desc "LazyGit-style TUI and CLI for the Fellow Aiden coffee brewer"
  homepage "https://github.com/mohammadalijf/lazyaiden"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@BASE_URL@/lazyaiden-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "@BASE_URL@/lazyaiden-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/lazyaiden-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "@BASE_URL@/lazyaiden-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  conflicts_with "@CONFLICTS@", because: "both install the lazyaiden and lazyaiden-cli binaries"

  def install
    bin.install "lazyaiden", "lazyaiden-cli"
    man1.install Dir["man/*.1"]
    %w[lazyaiden lazyaiden-cli].each do |cmd|
      bash_completion.install "completions/#{cmd}.bash" => cmd
      zsh_completion.install "completions/_#{cmd}"
      fish_completion.install "completions/#{cmd}.fish"
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/lazyaiden --version")
    assert_match version.to_s, shell_output("#{bin}/lazyaiden-cli --version")
    assert_match "lazyaiden-cli", shell_output("#{bin}/lazyaiden-cli --help")
  end
end
